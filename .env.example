# Copiar como .env y completar valores reales
# NUNCA subir .env a Git

# Perfil: dev (local) | prod (servidor)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL (perfil prod; en dev se usa application-dev.properties)
DB_APP_USER=sgi_admin
DB_APP_PASSWORD=

# Seguridad — OBLIGATORIAS en prod (mínimo 32 caracteres, la app no arranca sin ellas)
# Generar con: openssl rand -base64 48
SGI_JWT_SECRET=
# Cifra la contraseña SMTP guardada en BD. Si se cambia, hay que volver a guardar la config SMTP.
SGI_ENCRYPTION_KEY=

# Aplicación
SGI_APP_URL=http://localhost:4200
SGI_UPLOAD_PATH=/opt/sgi/uploads
