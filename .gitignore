# Maven / compilados
target/
!.mvn/wrapper/maven-wrapper.jar
*.jar
*.war
*.class

# Credenciales - NUNCA subir
.env
.env.*
!.env.example
application-dev.properties
application-prod.properties

# IDE
.idea/
*.iml
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Archivos locales de desarrollo y pruebas
*.ps1
login*.json
nginx.conf.temp
$null
*.docx
SGI-BACKEND-API-REFERENCIA.md

# Documentación técnica local (no va a git)
docs/

# Herramientas locales
.github/java-upgrade/
.github/modernize/
